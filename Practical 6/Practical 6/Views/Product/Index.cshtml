@model List<Practical_6.Models.Product>

<h1>Product List</h1>

<table border="1">

    <tr>
        <th>Product Name</th>
        <th>Category</th>
        <th>Price</th>
        <th>Quantity</th>
        <th>Details</th>
    </tr>

    @foreach (var p in Model)
    {
        <tr>
            <td>@p.ProductName</td>
            <td>@p.Category</td>
            <td>@p.Price</td>
            <td>@p.Quantity</td>
            <td>
                @Html.ActionLink("Details", "Details", new { id = p.ProductId })
            </td>
        </tr>
    }

</table>