@model List<Practical_7.Models.Feedback>

@{
    ViewBag.Title = "Feedback List";
}

<!DOCTYPE html>
<html>
<head>
    <title>Feedback List</title>
</head>
<body>
    <h2>Student Feedback Records</h2>

    <table border="1" cellpadding="8">
        <tr>
            <th>Enrollment Number</th>
            <th>Student Name</th>
            <th>Subject</th>
            <th>Rating</th>
            <th>Comment</th>
        </tr>

        @foreach (var feedback in Model)
        {
            <tr>
                <td>@feedback.EnrollmentNumber</td>
                <td>@feedback.StudentName</td>
                <td>@feedback.Subject</td>
                <td>@feedback.Rating</td>
                <td>@feedback.Comment</td>
            </tr>
        }
    </table>

    <p>
        <a href="@Url.Action("Create", "Feedback")">Add Feedback</a>
    </p>

    <p>
        <a href="@Url.Action("Index", "Feedback")">Back to Home</a>
    </p>
</body>
</html>